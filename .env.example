# Copy this file to .env.local (which is gitignored) and paste your published Sheet link.
# Google Sheets: File > Share > Publish to web > Spots tab > Comma-separated values (.csv)
VITE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/YOUR-PUBLISHED-ID/pub?gid=0&single=true&output=csv

# Optional: "Suggest a spot" Google Form. In the form: More (three dots) > Get pre-filled link,
# answer the Latitude question with LAT and the Longitude question with LNG, then Get link.
VITE_SUGGEST_FORM_URL=https://docs.google.com/forms/d/e/YOUR-FORM-ID/viewform?usp=pp_url&entry.111=LAT&entry.222=LNG
